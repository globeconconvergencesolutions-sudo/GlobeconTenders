# Copy to .env.local for Next.js

DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Local PIS branch only. When true, the app uses SECONDARY_DATABASE_URL
# and does not write to DATABASE_URL. Leave unset in production.
# USE_SECONDARY_DATABASE=true
# SECONDARY_DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# Initial super admin (used by pnpm db:seed on first run)
SEED_SUPER_ADMIN_EMAIL=globeconconvergencesolutions@gmail.com
SEED_SUPER_ADMIN_PASSWORD=Globecon@2026

# Cron / n8n sync + ingest endpoint auth
SYNC_CRON_SECRET=replace-with-a-long-random-secret

# Optional dedicated secret for n8n opportunity ingest (falls back to SYNC_CRON_SECRET)
# INGEST_SECRET=replace-with-a-long-random-secret

# Public app URL for this deployment (links + n8n ingest URL). Change per host.
# Staging: https://gcstendersvic.netlify.app
# Prod:    https://gcstenders.netlify.app
APP_URL=http://localhost:3000

# Auth.js canonical URL — must match APP_URL host for cookies/logout
# AUTH_URL=https://gcstendersvic.netlify.app

# Cloudinary (document source storage — matches upload preset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=GlobeconTender
CLOUDINARY_ROOT_FOLDER=Globeconcs

# Gmail alerts (Google Account → Security → 2-Step Verification → App passwords)
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_FROM_NAME=Globecon Tender Watch
EMAIL_ALERTS_ENABLED=true

# Optional Stripe billing (Phase 6 hooks — checkout disabled until configured)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional model for extra requirement suggestions. Leave blank to stay on rules.
# PIS_MODEL_API_KEY=
# PIS_MODEL_BASE_URL=https://api.openai.com/v1
# PIS_MODEL_NAME=gpt-4o-mini
